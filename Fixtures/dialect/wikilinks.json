        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "CRLF",
    "input": "[[A]]\r\n[[B]]\r\n",
    "expected": [
      {
        "target": "A",
        "heading": null,
        "alias": null
      },
      {
        "target": "B",
        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "in html comment",
    "input": "<!-- [[hidden]] -->",
    "expected": []

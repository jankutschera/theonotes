[
  {
    "name": "plain",
    "input": "[[Note]]",
    "expected": [
      {
        "target": "Note",
        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "heading",
    "input": "[[Note/Heading]]",
    "expected": [
      {
        "target": "Note",
        "heading": "Heading",
        "alias": null
      }
    ]
  },
  {
    "name": "same-note heading",
    "input": "[[/Heading]]",
    "expected": [
      {
        "target": "",
        "heading": "Heading",
        "alias": null
      }
    ]
  },
  {
    "name": "alias",
    "input": "[[Note|alias]]",
    "expected": [
      {
        "target": "Note",
        "heading": null,
        "alias": "alias"
      }
    ]
  },
  {
    "name": "heading and alias",
    "input": "[[Note/Heading|alias]]",
    "expected": [
      {
        "target": "Note",
        "heading": "Heading",
        "alias": "alias"
      }
    ]
  },
  {
    "name": "in code span",
    "input": "`[[code]]`",
    "expected": []
  },
  {
    "name": "blank",
    "input": "[[ ]]",
    "expected": []
  },
  {
    "name": "empty",
    "input": "[[]]",
    "expected": []
  },
  {
    "name": "two links",
    "input": "Two [[A]] and [[B]]",
    "expected": [
      {
        "target": "A",
        "heading": null,
        "alias": null
      },
      {
        "target": "B",
        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "trimmed",
    "input": "[[Spaced Note ]]",
    "expected": [
      {
        "target": "Spaced Note",
        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "in fenced code",
    "input": "```\n[[in code]]\n```",
    "expected": []
  },
  {
    "name": "escaped slash in title",

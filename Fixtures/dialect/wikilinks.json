      {
        "target": "Note",
        "heading": null,
        "alias": "alias"
      }
    ]
  },
  {
    "name": "empty alias",
    "input": "[[Note|]]",
    "expected": [
      {
        "target": "Note",
        "heading": null,
        "alias": null
      }
    ]
  },
  {
    "name": "unclosed",
    "input": "[[Unclosed",
    "expected": []
  },
  {
    "name": "unicode",
    "input": "[[Ünïcödé 日本]]",

[
  {"name": "empty query", "query": "", "expected": {"and": []}},
  {"name": "whitespace only", "query": "  \t ", "expected": {"and": []}},
  {"name": "single term", "query": "system", "expected": {"term": "system"}},
  {"name": "implicit and", "query": "system founder", "expected": {"and": [{"term": "system"}, {"term": "founder"}]}},
  {"name": "or", "query": "system or founder", "expected": {"or": [{"term": "system"}, {"term": "founder"}]}},
  {"name": "OR uppercase and mixed case", "query": "a OR b Or c", "expected": {"or": [{"term": "a"}, {"term": "b"}, {"term": "c"}]}},
  {"name": "or binds looser than and (left)", "query": "a b or c", "expected": {"or": [{"and": [{"term": "a"}, {"term": "b"}]}, {"term": "c"}]}},
  {"name": "or binds looser than and (right)", "query": "a or b c", "expected": {"or": [{"term": "a"}, {"and": [{"term": "b"}, {"term": "c"}]}]}},
  {"name": "leading or dropped", "query": "or system", "expected": {"term": "system"}},
  {"name": "trailing or dropped", "query": "system or", "expected": {"term": "system"}},
  {"name": "double or collapses", "query": "a or or b", "expected": {"or": [{"term": "a"}, {"term": "b"}]}},
  {"name": "lone or is the empty query", "query": "or", "expected": {"and": []}},
  {"name": "negated or is false", "query": "a -or b", "expected": {"and": [{"term": "a"}, {"not": {"and": []}}, {"term": "b"}]}},
  {"name": "negated term", "query": "-system", "expected": {"not": {"term": "system"}}},
  {"name": "negation inside or", "query": "-system or build", "expected": {"or": [{"not": {"term": "system"}}, {"term": "build"}]}},
  {"name": "dash alone is a term", "query": "-", "expected": {"term": "-"}},
  {"name": "double dash negates the literal rest", "query": "--system", "expected": {"not": {"term": "-system"}}},
  {"name": "inner dash is literal", "query": "system-build", "expected": {"term": "system-build"}},
  {"name": "phrase", "query": "\"the system\"", "expected": {"phrase": "the system"}},
  {"name": "single word phrase", "query": "\"build\"", "expected": {"phrase": "build"}},
  {"name": "negated phrase", "query": "-\"the system\" founder", "expected": {"and": [{"not": {"phrase": "the system"}}, {"term": "founder"}]}},
  {"name": "unterminated quote is literal", "query": "\"the system", "expected": {"and": [{"term": "\"the"}, {"term": "system"}]}},
  {"name": "empty quotes are literal", "query": "\"\"", "expected": {"term": "\"\""}},
  {"name": "phrase next to term", "query": "x \"a b\" y", "expected": {"and": [{"term": "x"}, {"phrase": "a b"}, {"term": "y"}]}},
  {"name": "phrase in or chain", "query": "\"a b\" or c", "expected": {"or": [{"phrase": "a b"}, {"term": "c"}]}},
  {"name": "tag", "query": "#type", "expected": {"tag": "type", "mode": "withDescendants"}},
  {"name": "nested tag keeps spelling", "query": "#TYPE/Ref", "expected": {"tag": "TYPE/Ref", "mode": "withDescendants"}},
  {"name": "closed tag", "query": "#type/ref#", "expected": {"tag": "type/ref", "mode": "withDescendants"}},
  {"name": "trailing slash kept", "query": "#type/ref/", "expected": {"tag": "type/ref/", "mode": "withDescendants"}},
  {"name": "number tag needs closing hash", "query": "#2021#", "expected": {"tag": "2021", "mode": "withDescendants"}},
  {"name": "open number tag is a term", "query": "#2021", "expected": {"term": "#2021"}},
  {"name": "dash date tag is open", "query": "#2026-07-09", "expected": {"tag": "2026-07-09", "mode": "withDescendants"}},
  {"name": "multi word tag", "query": "#my tag# x", "expected": {"and": [{"tag": "my tag", "mode": "withDescendants"}, {"term": "x"}]}},
  {"name": "two tags are not one multi word tag", "query": "#a #b", "expected": {"and": [{"tag": "a", "mode": "withDescendants"}, {"tag": "b", "mode": "withDescendants"}]}},
  {"name": "exact tag", "query": "!#paperclip", "expected": {"tag": "paperclip", "mode": "exact"}},
  {"name": "subtags", "query": "#*/ref", "expected": {"tag": "ref", "mode": "subtagsOnly"}},
  {"name": "negated tag", "query": "-#type", "expected": {"not": {"tag": "type", "mode": "withDescendants"}}},
  {"name": "negated exact tag is ignored (Bear)", "query": "-!#paperclip system", "expected": {"term": "system"}},
  {"name": "negated subtags are ignored (Bear)", "query": "-#*/ref", "expected": {"and": []}},
  {"name": "exact subtags are a literal term", "query": "!#*/ref", "expected": {"term": "!#*/ref"}},
  {"name": "hash alone is a term", "query": "#", "expected": {"term": "#"}},
  {"name": "subtags without name is a term", "query": "#*/", "expected": {"term": "#*/"}},
  {"name": "bang alone is a term", "query": "!", "expected": {"term": "!"}},
  {"name": "tags combine with or", "query": "#adhd-founder or #type", "expected": {"or": [{"tag": "adhd-founder", "mode": "withDescendants"}, {"tag": "type", "mode": "withDescendants"}]}},
  {"name": "special todo", "query": "@todo", "expected": {"special": "@todo"}},

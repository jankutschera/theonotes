  {"name": "date in other local format is a term", "query": "@date(29.5.2026)", "expected": {"term": "@date(29.5.2026)"}},
  {"name": "invalid month is a term", "query": "@date(2026-13-01)", "expected": {"term": "@date(2026-13-01)"}},

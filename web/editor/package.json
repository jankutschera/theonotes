{
  "name": "baerchen-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//": [
    "Dependencies are pinned exactly. @codemirror/view: the app's integration test hooks (Apps/TheoNotesMac/Tests/EditorIntegrationTests.swift, LiveEditor.hooks) reach the EditorView through its internal `.cm-content` cmTile; re-check them when bumping it."
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --project unit && vitest run --project bundle",
    "e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "mermaid": "12.2.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

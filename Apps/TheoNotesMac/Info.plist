<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plain text document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(THEONOTES_URL_SCHEME)</string>
				<string>$(THEONOTES_LEGACY_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Theo Notes reads your notes from Apple Notes to import them.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Theo Notes records your voice note and keeps the recording with the note.</string>
	<key>THEONOTES_CloudKitContainer</key>
	<string>$(THEONOTES_CLOUDKIT_CONTAINER)</string>
	<key>THEONOTES_ICloudSyncAvailable</key>
	<string>$(THEONOTES_ICLOUD_SYNC)</string>
	<key>THEONOTES_PrivateSyncHost</key>
	<string>$(THEONOTES_PRIVATE_SYNC_HOST)</string>
	<key>THEONOTES_SyncSetupAvailable</key>
	<string>$(THEONOTES_SYNC_SETUP)</string>
	<key>THEONOTES_TeamID</key>
	<string>$(THEONOTES_TEAM_ID)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Theo Notes backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.truebrewbirdie.theonotes.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>theonotes-backup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Theo Notes notes</string>
			<key>UTTypeIdentifier</key>
			<string>$(THEONOTES_BUNDLE_ROOT).note-ids</string>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Theo Notes tag</string>
			<key>UTTypeIdentifier</key>
			<string>$(THEONOTES_BUNDLE_ROOT).tag-path</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Theo Notes backup (earlier version)</string>
			<key>UTTypeIdentifier</key>
			<string>com.truebrewbirdie.baerchen.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>baerchen-backup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

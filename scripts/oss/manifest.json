{
  "_comment": "Allow-list for the public export (REN2-R20). Only paths matching include and not matching exclude are copied from HEAD. Regexes below are written so that they do not match their own text.",
  "include": [
    "Apps/**",
    "Packages/**",
    "web/editor/src/**",
    "web/editor/e2e/**",
    "web/editor/test/**",
    "web/editor/scripts/**",
    "web/editor/patches/**",
    "web/editor/stubs/**",
    "web/editor/*.json",
    "web/editor/*.ts",
    "web/editor/*.html",
    "web/editor/pnpm-lock.yaml",
    "web/editor/pnpm-workspace.yaml",
    "Fixtures/**",
    "scripts/**",
    "config/**",
    "project.yml",
    "docs/legal/**",
    "docs/brand/PROVENANCE.md",
    "docs/brand/app-icon-1024.png",
    "docs/readme/**",
    "docs/ARCHITECTURE.md",
    "docs/crypto-labels.md",
    "docs/backup-format.md",
    ".gitignore",
    ".gitattributes",
    ".github/**",
    "LICENSE",
    "LICENSES/**",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CLA.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "TRADEMARK.md",
    "BRANDING.md",
    "README.md"
  ],
  "exclude": [
    "scripts/status.py",
    "scripts/bear-oracle.sh",
    "Packages/TheoNotesCore/Sources/bear-oracle/**",
    "Packages/TheoNotesCore/Tests/BearOracleTests/**",
    "scripts/tools/**",
    "scripts/oss/overlays/**",
    "scripts/rename/**",
    "scripts/tests/test_stage2_rename.py",
    "services/**",
    "website/**",
    "config/private-sync.xcconfig",
    "**/.DS_Store",
    "**/node_modules/**",
    "**/*.xcodeproj/**"
  ],
  "overlays": {
    "CLAUDE.md": "scripts/oss/overlays/CLAUDE.md",
    "AGENTS.md": "scripts/oss/overlays/AGENTS.md",
    "README.md": "scripts/oss/overlays/README.md"
  },
  "redact": [],
  "scan": {
    "rules": {
      "forbidden-path": true,
      "working-title": true,
      "bear-text": true,
      "ip-guard": true,
      "research-shingle": true,
      "adhd-copy": true,
      "secret-pattern": true,
      "secret-entropy": true,
      "private-email": true,
      "personal-marker": true,
      "cloudflare-id": true,
      "team-id": true,
      "large-file": true,
      "symlink-escape": true,
      "spdx-header": false
    },
    "forbidden_paths": [
      "docs/research/**",
      "docs/oracle/**",
      "docs/bear-community-audit.md",
      ".superpowers/**",
      "SESSION_LOG.md",
      "LESSONS.md",
      "docs/status/**",
      "docs/release/evidence/**",
      "docs/reviews/**",
      "services/**",
      "website/**",
      "config/private-sync.xcconfig",
      "build/**",
      "**/build/**",
      "**/*.xcodeproj",
      "**/*.xcodeproj/**",
      "**/node_modules",
      "**/node_modules/**",
      "**/.env",
      "**/.env.*",
      "**/keys.env",
      "**/*.p12",
      "**/*.mobileprovision",
      "**/*.pem",
      "**/*.key",
      "**/.git",
      "**/.git/**",
      "**/.DS_Store"
    ],
    "frozen_label_suffixes": [
      "envelope-v1", "journal-v1", "sync:1", "account:1", "transfer:1", "transfer-key:1",
      "transfer-words:1", "device-name:1", "conflict:1", "request:1", "recovery:1", "semantic-id:1"
    ],
    "frozen_label_paths": [
      "**/ProtocolLabels.swift",
      "services/sync/src/labels.ts",
      "docs/crypto-labels.md",
      "Fixtures/crypto/**",
      "Fixtures/sync/**"
    ],
    "bear_text_patterns": [
      "https?://[\\w.-]*bear\\.app",
      "\\w+@bear\\.app",
      "shiny[ _-]?frog",
      "red[ ]graphite",
      "bear[ ]sans"
    ],
    "bear_text_allow": [
      {
        "path": "**",
        "match": "net\\.shiny[f]rog\\.bear",
        "reason": "TextBundle metadata key the importer must read to open notes exported by the other app; a reverse-DNS identifier (interface fact), not copied prose"
      }
    ],
    "shingle_allow": [
      {"path": "Fixtures/cli/{cli-observed,contract,help-prose}.json", "reason": "CLI contract fixtures: usage lines, option and field names are interface facts; the prose sentences in help-prose.json were rewritten in our own words and the remaining runs reviewed"},
      {"path": "Fixtures/mcp/descriptions.json", "reason": "the keys are schema paths (tool, property and field names); the description values were rewritten and the remaining runs reviewed as key paths"},
      {"path": "Packages/TheoNotesCore/Sources/bear-oracle/{CLIParityCheck,CLIProbe}.swift", "reason": "the CLI field list in the private compatibility checker: field names are interface facts (tool moves out of the export in plan task A6)"},
      {"path": "Fixtures/mcp/tool-schemas.json", "reason": "JSON schema skeletons of the MCP tools: tool, field and type names are interface facts and carry no description text"},
      {"path": "Packages/TheoNotesCore/Sources/TheoNotesAutomation/Generated/*.swift", "reason": "generated from the reviewed fixtures above (scripts/gen-automation-sources.py --check keeps them in step)"},
      {"path": "Packages/TheoNotesCore/Sources/TheoNotesCore/Resources/{getting-started,starter-v1,starter-v2}-3-tags-and-links.md", "reason": "shipped starter note and its versioned copies (starter-v1 = the 1.0 text, starter-v2 = the 1.1 text, both frozen and digest-pinned by the starter upgrade tests); the one flagged run is the same short generic tagging instruction in each, reviewed 2026-11-25"},
      {"path": "Packages/TheoNotesCore/Sources/TheoNotesAutomation/CLI/CommandTable.swift", "reason": "the CLI field list: field names are interface facts"},
      {"path": "Packages/TheoNotesCore/Tests/**/{ReadCommandsTests,NoteResolverTests,CLIContractFixtureTests,MCPCatalogTests}.swift", "reason": "tests that pin the CLI field list and the catalog JSON structure (field and key names)"},
      {"path": "Apps/TheoNotesMac/Tests/{BlockMenuTests,FormatCommandsTests,MainWindowChromeTests}.swift", "reason": "menu item titles of generic table and view commands (Add Row, Delete Column, Show Editor Only); short UI command names, no sentences"}
    ],
    "entropy_allow": [
      {"path": "Fixtures/crypto/v1/canonical.json", "reason": "synthetic compatibility vectors written by Fixtures/crypto/v1/generate.swift (its README: every password, key, salt and nonce is invented). Checked: the derived key equals PBKDF2-SHA256 of the invented password and the incrementing-byte salt at 1000 iterations, and the vault key is the bytes 0,1,2,3 and so on"},
      {"path": "Fixtures/sync/{account-keys-v1,cloudsync-payload-v1,cloudkit-record-v1}.json", "reason": "golden sync vectors with fixed fixture account ids (account-fixture-001, ck-vector-account-001), the all-abandon test recovery phrase, an all-0x02 vault key and a canary payload of repeated 0x11 bytes; the specs are docs/superpowers/specs/2026-10-23-sync-wire-v1.md and 2026-10-28-sync-payload-v1.md"},
      {"path": "Fixtures/import/evernote/Media.enex", "reason": "base64 of a 1x1 pixel PNG (it starts with the PNG signature), the attachment of the import fixture"},
      {"path": "Packages/TheoNotesCore/Tests/TheoNotesCoreTests/CloudSync/Live/LiveGatewayFixture.swift", "reason": "archived data of a CloudKit record (system fields only), decoded and checked: it holds the record type, the record name, a random test zone name, the default owner marker and a change tag; no account or user id, token or key"},
      {"path": "Packages/TheoNotesCore/Tests/**/*Tests.swift", "match": "func\\s+\\w+", "reason": "long Swift test function names, not tokens"}
    ],
    "adhd_extra_paths": ["README.md", "BRANDING.md", "docs/store/**", ".github/**"],
    "secret_patterns": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "\\bAKIA[0-9A-Z]{16}\\b",
      "\\bghp_[A-Za-z0-9]{30,}",
      "\\bgithub_pat_[A-Za-z0-9_]{20,}",
      "\\bxox[abp]-[A-Za-z0-9-]{10,}",
      "\\bsk-[A-Za-z0-9_-]{20,}",
      "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "\\bBearer [A-Za-z0-9._~+/-]{20,}",
      "CLOUDFLARE_(?:API_TOKEN|API_KEY|ACCOUNT_ID)\\s*[=:]\\s*\\S{8,}"
    ],
    "entropy_min": 4.5,
    "entropy_min_len": 32,
    "entropy_skip_paths": [
      "**/pnpm-lock.yaml",
      "**/package-lock.json",
      "**/Package.resolved",
      "**/yarn.lock",
      "scripts/tests/test_oss_export.py",
      "**/Acknowledgements.json"
    ],
    "allowed_emails": ["hello@theonotes.app"],
    "allowed_email_domains": ["example.com", "example.org", "example.net", "localhost"],
    "email_skip_paths": [
      "**/Acknowledgements.json",
      "**/theme-license-*.txt",
      "web/editor/patches/**",
      "LICENSES/**",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "docs/legal/**"
    ],
    "personal_patterns": [
      "/Users/(?!Shared\\b|me\\b|you\\b|user\\b|username\\b|name\\b|example\\b|runner\\b)[A-Za-z0-9._-]+",
      "(?<!github\\.com/)(?<!\\n\\* @)jankutsch[e]ra|jankutsch[e]ra(?!/theonotes\\b|\\n)",
      "k-producti[o]n",
      "\\.config/secre[t]s"
    ],
    "cloudflare_patterns": [
      "(?i)(?:account|database|zone)[_-]?id\\W{0,6}[0-9a-f]{32}\\b",
      "(?i)cloudflare\\b[^\\n]{0,60}\\b[0-9a-f]{32}\\b",
      "\\.workers\\.dev\\b",
      "\\b[0-9a-f]{32}(?:\\.[a-z]{2,4})?\\.r2\\.cloudflarestorage\\.com\\b"
    ],
    "team_id_patterns": ["\\b5KZGD4R9[K]7\\b"],
    "team_id_skip_paths": ["config/*.env"],
    "large_file_bytes": 5242880,
    "large_file_ok": [],
    "spdx_suffixes": [".swift", ".ts", ".tsx", ".js", ".mjs", ".py", ".sh", ".css"],
    "spdx_skip_paths": [
      "Fixtures/**",
      "docs/**",
      "web/editor/patches/**",
      "**/node_modules/**",
      "**/Resources/**",
      "website/**"
    ],
    "shingle_words": 9
  }
}
